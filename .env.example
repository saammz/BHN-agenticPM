# OpenRouter — paste your key here (copy this file to .env). Without a key, use --llm mock.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-5.5"
# Comma-separated models OpenRouter falls back to if the primary is down/rate-limited
OPENROUTER_FALLBACK_MODELS="anthropic/claude-sonnet-4.5,openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Agent behaviour
AGENT_MODE="auto"            # auto | assist | shadow
AGENT_MAX_STEPS="6"          # max LLM turns per portfolio
CONF_MIN_ACT="0.6"           # below this, any finding goes to human review only
CONF_AUTO_REMIND="0.75"      # LLM-judged findings need this to auto-send a PM reminder

# Failure drills
MOCK_DATASOURCE_FAIL="0"     # 1 = simulate the submissions DB being unreachable

# ── Database ─────────────────────────────────────────────────────────────
# Neon connection string (pooled). Empty = local SQLite at state/agentpm.db
DATABASE_URL=""

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="BNH Compliance Agent <agent@your-verified-domain.com>"
# Compliance emails from the agent: simulated | resend | redirect
#   redirect = send for real, but every agent email goes to AGENT_EMAIL_REDIRECT_TO (safe for demos)
AGENT_EMAIL_DELIVERY="simulated"
AGENT_EMAIL_REDIRECT_TO=""

# ── Web & sign-in ────────────────────────────────────────────────────────
APP_URL="http://localhost:8765"
TRUST_PROXY="0"              # 1 only behind a proxy that sets X-Forwarded-For
SEED_COS_NAME="Chief of Staff"
SEED_COS_EMAIL=""            # first CoS account, created by: agentpm.py db seed
# AUTH_SECRET and WEBHOOK_SECRET are generated into .env automatically on first run

# ── Hosted deployment (Vercel) ───────────────────────────────────────────
# AUTH_SECRET / WEBHOOK_SECRET: set explicitly (any long random string) so every instance signs codes the same way
AUTH_SECRET=""
WEBHOOK_SECRET=""
CRON_SECRET=""               # Vercel Cron sends this as a Bearer token to /api/cron/daily
